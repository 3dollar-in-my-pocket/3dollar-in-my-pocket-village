{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 최상위 설정은 로컬 개발(npm run dev) 전용입니다. 배포는 항상 --env dev 또는 --env production으로 합니다.
  "name": "boong-village-local",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/ws", "/dev-login", "/guest-login"]
  },
  "durable_objects": {
    "bindings": [{ "name": "VILLAGE", "class_name": "Village" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Village"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boong-village",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "THREEDOLLARS_API": "https://dev.threedollars.co.kr",
    "VILLAGE_CAPACITY": "50",
    "BOTS": "1",
    "AUTH_MODE": "hybrid",
    "DEV_AUTH": "1",
    "FEATURE_THUMBS": "1",
    "FEATURE_SHOP": "1",
    "FEATURE_AWAY": "1",
    "FEATURE_PARTTIMER": "1"
  },
  "env": {
    "dev": {
      "name": "boong-village-dev",
      "vars": {
        "THREEDOLLARS_API": "https://dev.threedollars.co.kr",
        "VILLAGE_CAPACITY": "50",
        "BOTS": "1",
        "AUTH_MODE": "hybrid",
        "DEV_AUTH": "0",
        "FEATURE_THUMBS": "1",
        "FEATURE_SHOP": "1",
        "FEATURE_AWAY": "1",
        "FEATURE_PARTTIMER": "1"
      },
      "durable_objects": {
        "bindings": [{ "name": "VILLAGE", "class_name": "Village" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "boong-village-dev",
          "database_id": "5767ae4e-91ea-4973-91e1-4371008b8e98",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "boong-village",
      "vars": {
        "THREEDOLLARS_API": "https://threedollars.co.kr",
        "VILLAGE_CAPACITY": "50",
        "BOTS": "0",
        "AUTH_MODE": "hybrid",
        "DEV_AUTH": "0",
        "FEATURE_THUMBS": "1",
        "FEATURE_SHOP": "1",
        "FEATURE_AWAY": "0",
        "FEATURE_PARTTIMER": "0"
      },
      "durable_objects": {
        "bindings": [{ "name": "VILLAGE", "class_name": "Village" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "boong-village",
          "database_id": "3a55a823-a790-4c20-8c0a-42d9c2f833d8",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
